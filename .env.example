# ─────────────────────────────────────────────────────────────
#  Copiez ce fichier en .env.local et remplissez les valeurs.
#  .env.local n'est jamais versionné.
# ─────────────────────────────────────────────────────────────

# ─── Base de données et tableau de bord (obligatoire) ───
# Tableau de bord Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://kmsriyxbxkmxsyxwxjjf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_vD2ZRIwGfQOcsumruN8GDQ_CrBlMDb3

# ⚠️ Clé de service — pouvoir total sur la base, contourne toutes les
# règles de sécurité. Jamais dans le navigateur, jamais dans git.
# Utilisée par les scripts npm run db:seed et db:admin, ainsi que par la
# route serveur app/admin/api/team/route.js (création de compte d'équipe).
SUPABASE_SERVICE_ROLE_KEY=

# ─── Chatbot IA (optionnel) ───
# Le fournisseur actif se choisit depuis /admin/parametres (menu déroulant),
# sans redéploiement. Ici, on ne renseigne que la clé du (ou des) fournisseur(s)
# qu'on compte utiliser — les autres peuvent rester vides. Sans clé pour le
# fournisseur choisi, le chatbot utilise ses réponses préprogrammées.
#
# Chaque *_MODEL est facultatif : à ne renseigner que pour remplacer le
# modèle par défaut (ex. si un fournisseur change ses identifiants de modèle).

# Claude (Anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# GPT (OpenAI)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Gemini et Gemma (Google AI Studio — même clé pour les deux)
GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.5-flash
# GOOGLE_GEMMA_MODEL=gemma-3-27b-it

# Grok (xAI)
XAI_API_KEY=
# XAI_MODEL=grok-3-mini

# Kimi (Moonshot AI)
MOONSHOT_API_KEY=
# MOONSHOT_MODEL=moonshot-v1-8k

# Qwen (Alibaba Cloud, mode compatible OpenAI)
DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus
