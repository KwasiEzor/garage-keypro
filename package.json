{
  "name": "keypro-service-center",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:seed": "node scripts/seed.mjs",
    "db:admin": "node scripts/create-admin.mjs",
    "db:types": "npx --yes supabase@latest gen types typescript --project-id kmsriyxbxkmxsyxwxjjf > types/database.generated.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests/unit",
    "test:watch": "vitest --dir tests/unit",
    "test:security": "vitest run --dir tests/security",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^16.2.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@eslint/eslintrc": "^3.2.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.19.0",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.9.0",
    "vitest": "^3.0.5"
  }
}
